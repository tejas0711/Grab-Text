{
  "manifest_version": 3,
  "minimum_chrome_version": "109",
  "name": "Grab Text",
  "version": "1.0.0",
  "description": "Select an area of your screen and copy its text with OCR.",
  "permissions": [
    "activeTab",
    "offscreen",
    "clipboardWrite",
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_title": "Grab Text"
  },
  "commands": {
    "grab-text": {
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      },
      "description": "Select an area to copy its text"
    }
  },
  "options_page": "options.html"
}
